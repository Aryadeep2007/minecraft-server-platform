# Copy these values into the service manager's environment configuration.
# This file is a template only; the application does not automatically load it.
MINECRAFT_DASHBOARD_ALLOWLIST_FILE=/path/to/private/dashboard-allowed-user
MINECRAFT_DASHBOARD_DIRECTORY=/path/to/minecraft-server-platform/web-dashboard
MINECRAFT_DASHBOARD_ORIGIN=https://dashboard.example.invalid
MINECRAFT_BRIDGE_TOKEN_FILE=/path/to/private/bridge-token
MINECRAFT_SERVER_PROPERTIES_FILE=/path/to/minecraft/server.properties
MINECRAFT_WORLD_DIRECTORY=/path/to/minecraft/world-container
